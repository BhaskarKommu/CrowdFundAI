@page "/currency"
@rendermode InteractiveServer
@inject NavigationManager Nav
@inject IHttpClientFactory HttpFactory

<PageTitle>Multi-currency — CrowdFund AI</PageTitle>

<div class="page-container py-5" style="max-width:640px;">
    <h1 class="fw-bold mb-1">Multi-currency display</h1>
    <p class="text-muted">Indicative conversion only. Settlement stays in the campaign currency.</p>

    <div class="cf-card">
        <div class="row g-2">
            <div class="col-4"><input class="form-control" type="number" @bind="amount" /></div>
            <div class="col-4"><input class="form-control" @bind="from" placeholder="From" /></div>
            <div class="col-4"><input class="form-control" @bind="to" placeholder="Display as" /></div>
        </div>
        <button class="btn btn-primary cf-btn-primary mt-2" @onclick="Convert">Convert</button>
        @if (result != null)
        {
            <div class="mt-3">
                <div><strong>@result.Amount.ToString("N2") @result.Currency</strong>
                    @if (result.ConvertedAmount.HasValue)
                    {
                        <span> ≈ @result.ConvertedAmount.Value.ToString("N2") @result.DisplayCurrency</span>
                    }
                </div>
                <p class="small text-muted mt-2">@result.Disclosure</p>
            </div>
        }
    </div>
</div>

@code {
    decimal amount = 100;
    string from = "USD", to = "INR";
    ResultVm? result;
    async Task Convert()
    {
        var c = HttpFactory.CreateClient(); c.BaseAddress = new Uri(Nav.BaseUri);
        result = await c.GetFromJsonAsync<ResultVm>($"/api/currency/convert?amount={amount}&from={from}&to={to}");
    }
    public class ResultVm
    {
        public decimal Amount { get; set; }
        public string Currency { get; set; } = "";
        public decimal? ConvertedAmount { get; set; }
        public string? DisplayCurrency { get; set; }
        public string Disclosure { get; set; } = "";
    }
}
